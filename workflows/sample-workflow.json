{
  "name": "DBpia Paper Search and Filter",
  "nodes": [
    {
      "parameters": {},
      "id": "b1c2d3e4-f5g6-7h8i-9j0k-l1m2n3o4p5q6",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300],
      "webhookId": "",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DBPIA_API_URL }}/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "a1b2c3d4-e5f6-g7h8-i9j0-k1l2m3n4o5p6",
      "name": "DBpia Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [450, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "1",
          "name": "DBpia API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Filter and process articles\nconst articles = $input.all();\nconst processed = articles.map(article => ({\n  json: {\n    article_id: article.json.id,\n    title: article.json.title,\n    authors: article.json.authors,\n    publication_date: article.json.publishedAt,\n    source_journal: article.json.journal,\n    doi: article.json.doi,\n    relevance_score: 0.8, // Default score\n    processed: false,\n    created_at: new Date().toISOString()\n  }\n}));\nreturn processed;"
      },
      "id": "c1d2e3f4-g5h6-i7j8-k9l0-m1n2o3p4q5r6",
      "name": "Process Articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "article_tracking",
        "columns": "article_id,title,authors,publication_date,source_journal,doi,relevance_score,processed,created_at",
        "additionalFields": {}
      },
      "id": "d1e2f3g4-h5i6-j7k8-l9m0-n1o2p3q4r5s6",
      "name": "Save to Database",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [850, 300],
      "credentials": {
        "postgres": {
          "id": "2",
          "name": "PostgreSQL n8n"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $env.OPENAI_API_BASE || 'https://api.openai.com/v1' }}/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $env.OPENAI_MODEL || 'gpt-4o-mini' }}\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a research assistant. Rate the relevance of academic papers on a scale of 0 to 1.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Rate the relevance of this paper: {{ $json.title }}\n\nAbstract: {{ $json.abstract || 'Not available' }}\"\n    }\n  ],\n  \"max_tokens\": 10\n}",
        "options": {}
      },
      "id": "e1f2g3h4-i5j6-k7l8-m9n0-o1p2q3r4s5t6",
      "name": "Score Relevance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.relevance_score }}",
              "operation": "larger",
              "value2": 0.7
            }
          ]
        }
      },
      "id": "f1g2h3i4-j5k6-l7m8-n9o0-p1q2r3s4t5u6",
      "name": "Filter High Relevance",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1250, 300]
    }
  ],
