# =============================================================================
# .dockerignore - Files to exclude from Docker build context
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
docs/

# Development files
.env.example
.editorconfig

# Data directories (will be mounted as volumes)
data/
memory/

# CI/CD
.github/
.gitlab-ci.yml

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Test files
tests/
*.test.js
coverage/

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp
