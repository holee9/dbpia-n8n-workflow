# =============================================================================
# DBpia n8n Workflow - Environment Configuration
# =============================================================================
# This file contains all environment variables for the n8n workflow system.
# Copy this file to .env and fill in your actual values.
# DO NOT commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# n8n Core Configuration
# -----------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
NODE_ENV=production

# IMPORTANT: Generate a secure random key for encryption
# Use: openssl rand -hex 32 or npx n8n encryption:generate
N8N_ENCRYPTION_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_MIN_32_CHARS

# -----------------------------------------------------------------------------
# n8n Basic Authentication
# -----------------------------------------------------------------------------
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# -----------------------------------------------------------------------------
# n8n Editor and Webhook Configuration
# -----------------------------------------------------------------------------
N8N_EDITOR_BASE_URL=/
WEBHOOK_URL=http://localhost:5678/

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DB_NAME=n8n
DB_USER=n8n
# Generate a strong password for PostgreSQL
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
DB_PORT=5432

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# n8n Performance Settings (Raspberry Pi Optimized)
# -----------------------------------------------------------------------------
# Concurrency limit for production execution
N8N_CONCURRENCY_PRODUCTION_LIMIT=2
# Worker concurrency (when using worker profile)
N8N_WORKER_CONCURRENCY=2

# Payload size limit in MB
N8N_PAYLOAD_SIZE_MAX=16

# Execution timeouts in seconds
EXECUTIONS_TIMEOUT=3600
EXECUTIONS_TIMEOUT_MAX=7200

# -----------------------------------------------------------------------------
# n8n Logging Configuration
# -----------------------------------------------------------------------------
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
N8N_LOG_FILE_COUNT_MAX=100
N8N_LOG_FILE_SIZE_MAX=16
N8N_LOG_FILE_LOCATION=/home/node/.n8n/logs
N8N_METRICS=true

# -----------------------------------------------------------------------------
# n8n Feature Flags
# -----------------------------------------------------------------------------
N8N_DISABLE_EDITOR_RAW_MODE=false
N8N_ENABLE_EDITOR_SHAVING_ENDPOINT=true
N8N_ENDPOINT_WEBHOOK=webhook
N8N_ENDPOINT_WEBHOOK_TEST=webhook-test

# -----------------------------------------------------------------------------
# DBpia API Configuration
# -----------------------------------------------------------------------------
# Get your API key from https://www.dbpia.co.kr
DBPIA_API_KEY=your_dbpia_api_key_here
DBPIA_API_URL=https://api.dbpia.co.kr

# -----------------------------------------------------------------------------
# OpenAI/LLM Configuration (for relevance scoring)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Alternative: Use local LLM with Ollama
# OPENAI_API_BASE=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2

# -----------------------------------------------------------------------------
# Timezone Configuration
# -----------------------------------------------------------------------------
TZ=Asia/Seoul
GENERIC_TIMEZONE=Asia/Seoul

# =============================================================================
# Optional: Advanced Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# External Services
# -----------------------------------------------------------------------------
# AWS S3 for external file storage (optional)
# AWS_S3_ACCESS_KEY_ID=your_aws_access_key
# AWS_S3_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=your_bucket_name
# AWS_S3_REGION=us-east-1

# SMTP Configuration for email notifications (optional)
# N8N_SMTP_HOST=smtp.gmail.com
# N8N_SMTP_PORT=587
# N8N_SMTP_USER=your_email@gmail.com
# N8N_SMTP_PASS=your_app_password
# N8N_SMTP_SENDER=n8n@example.com

# -----------------------------------------------------------------------------
# Security (Advanced)
# -----------------------------------------------------------------------------
# N8N_CUSTOM_INSTALL_PATH=/n8n
# N8N_PATH=/n8n
# N8N_HOST=https://your-domain.com

# JWT Secret for webhooks (optional but recommended)
# WEBHOOK_JWT_AUTH_HEADER=authorization
# WEBHOOK_JWT_AUTH_HEADER_VALUE_PREFIX=Bearer
# WEBHOOK_JWT_AUTH_ALGORITHM=HS256
# WEBHOOK_JWT_AUTH_ISSUER=
# WEBHOOK_JWT_AUTH_AUDIENCE=
# WEBHOOK_JWT_AUTH_TTL=3600
# WEBHOOK_JWT_AUTH_SECRET=
